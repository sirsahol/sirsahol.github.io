---
// ContactInlet.astro — Enterprise Normalization & Direct Communications Inlet
// Enforces admin-scaffold-protocol 3-phase form integrity (Normalize -> Sanitize -> Validate)
// Direct client dispatch + Guaranteed Google Calendar / Meet integration + Zero email exposure
---

<section id="contact" class="pt-16 pb-20 border-t border-zinc-200 dark:border-zinc-800 scroll-mt-20">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
    <!-- Left Column: Context & Synchronous Meet Scheduling -->
    <div class="lg:col-span-5 space-y-6">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-mono text-emerald-600 dark:text-emerald-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>03 • Availability & Communications Inlet</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100">
          Initiate Contact & Systems Inquiries
        </h2>
        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Available for fractional systems architecture, Apple Silicon on-device ML quantization pipelines, distributed infrastructure design, and principal engineering engagements.
        </p>
      </div>

      <!-- Fast Path: Google Meet / Calendar Scheduling Template (Direct to /meet) -->
      <div class="pt-4 border-t border-zinc-200 dark:border-zinc-800/80 space-y-3">
        <span class="text-xs font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
          Synchronous Fast-Path
        </span>
        <div class="space-y-2">
          <a
            id="gcal-schedule-link"
            href="/meet"
            class="inline-flex items-center justify-between w-full p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 hover:border-emerald-500/60 dark:hover:border-emerald-400/60 hover:bg-emerald-50/20 dark:hover:bg-emerald-950/20 transition-all group"
          >
            <div class="space-y-0.5 text-left">
              <div class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 flex items-center gap-2">
                <span>Book 20-Min Architecture Briefing</span>
                <span class="text-xs px-2 py-0.5 rounded-xs bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 font-mono font-medium">1st Session Free</span>
              </div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">
                Direct calendar reservation with auto-issued Google Meet video conference room.
              </p>
            </div>
            <span class="font-mono text-zinc-400 group-hover:text-emerald-500 group-hover:translate-x-1 transition-all">→</span>
          </a>
        </div>
      </div>

      <!-- Developer Hub References (Zero Email Exposure) -->
      <div class="pt-4 border-t border-zinc-200 dark:border-zinc-800/80 space-y-2 text-xs sm:text-sm font-mono text-zinc-600 dark:text-zinc-400">
        <div class="flex items-center justify-between">
          <span class="text-zinc-400">Response Window:</span>
          <span class="text-zinc-700 dark:text-zinc-300 font-medium">Within 24–48 Business Hours</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-zinc-400">Verified Hubs:</span>
          <span>
            <a href="https://github.com/SirSahOl" target="_blank" rel="noopener noreferrer" class="hover:text-sky-600 dark:hover:text-sky-400 underline">GitHub</a>
            <span class="mx-1.5 text-zinc-400">•</span>
            <a href="https://huggingface.co/SirSahOl" target="_blank" rel="noopener noreferrer" class="hover:text-sky-600 dark:hover:text-sky-400 underline">Hugging Face</a>
            <span class="mx-1.5 text-zinc-400">•</span>
            <a href="https://www.linkedin.com/in/zahyd/" target="_blank" rel="noopener noreferrer" class="hover:text-sky-600 dark:hover:text-sky-400 underline">LinkedIn</a>
          </span>
        </div>
      </div>
    </div>

    <!-- Right Column: 3-Phase Normalized Async Form (Zero Cards — Direct on Canvas) -->
    <div class="lg:col-span-7">
      <div class="border-t lg:border-t-0 lg:border-l border-zinc-200 dark:border-zinc-800 lg:pl-10 xl:pl-14 pt-8 lg:pt-0">
        <div class="pb-4 mb-6 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between text-xs font-mono text-zinc-400">
          <span class="font-semibold text-zinc-700 dark:text-zinc-300">Technical Briefing Ingestion</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-medium">Direct Channel</span>
        </div>

        <form id="inlet-form" class="space-y-5" novalidate>
          <!-- 2-Column Name Grid: First Name & Last Name (Normalized) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="client-first-name" class="block text-xs font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-400 font-medium">
                First Name <span class="text-sky-500">*</span>
              </label>
              <input
                id="client-first-name"
                name="firstName"
                type="text"
                required
                placeholder="e.g. Alex"
                class="w-full px-3.5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950/60 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:border-sky-500 dark:focus:border-sky-400 transition-colors"
              />
              <span id="err-firstName" class="hidden text-xs text-rose-500 font-mono"></span>
            </div>

            <div class="space-y-1.5">
              <label for="client-last-name" class="block text-xs font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-400 font-medium">
                Last Name <span class="text-sky-500">*</span>
              </label>
              <input
                id="client-last-name"
                name="lastName"
                type="text"
                required
                placeholder="e.g. Rivera"
                class="w-full px-3.5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950/60 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:border-sky-500 dark:focus:border-sky-400 transition-colors"
              />
              <span id="err-lastName" class="hidden text-xs text-rose-500 font-mono"></span>
            </div>
          </div>

          <!-- Email & Organization Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="client-email" class="block text-xs font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-400 font-medium">
                Work / Institutional Email <span class="text-sky-500">*</span>
              </label>
              <input
                id="client-email"
                name="email"
                type="email"
                required
                placeholder="alex@organization.com"
                class="w-full px-3.5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950/60 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:border-sky-500 dark:focus:border-sky-400 transition-colors"
              />
              <span id="err-email" class="hidden text-xs text-rose-500 font-mono"></span>
            </div>

            <div class="space-y-1.5">
              <label for="client-org" class="block text-xs font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-400 font-medium">
                Organization / Studio (Optional)
              </label>
              <input
                id="client-org"
                name="organization"
                type="text"
                placeholder="e.g. Acme Systems / Independent"
                class="w-full px-3.5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950/60 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:border-sky-500 dark:focus:border-sky-400 transition-colors"
              />
            </div>
          </div>

          <!-- Inquiry Track Selector -->
          <div class="space-y-1.5">
            <label for="client-track" class="block text-xs font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-400 font-medium">
              Inquiry Track
            </label>
            <select
              id="client-track"
              name="track"
              class="w-full px-3.5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950/60 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:border-sky-500 dark:focus:border-sky-400 transition-colors font-mono text-xs sm:text-sm"
            >
              <option value="Fractional Systems Architecture">Fractional Systems Architect (Contract / Retainer)</option>
              <option value="On-Device ML & Apple Silicon Quantization">On-Device ML Quantization & Edge Benchmarking</option>
              <option value="Principal / Staff Systems Engineer Role">Full-Time Principal / Staff Engineering Role</option>
              <option value="Cloud Run & Distributed Mesh Review">Distributed Infrastructure & Security Architecture Audit</option>
              <option value="General Technical Advisory">General Technical Advisory</option>
            </select>
          </div>

          <!-- Brief / Scope Textarea -->
          <div class="space-y-1.5">
            <label for="client-message" class="block text-xs font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-400 font-medium">
              Project Brief, Scope & Timeline <span class="text-sky-500">*</span>
            </label>
            <textarea
              id="client-message"
              name="message"
              required
              rows="4"
              placeholder="Outline your systems architecture context, target hardware/runtimes, scope, or timeline (minimum 20 characters)..."
              class="w-full px-3.5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-950/60 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:border-sky-500 dark:focus:border-sky-400 transition-colors"
            ></textarea>
            <div class="flex items-center justify-between text-[11px] font-mono text-zinc-400 pt-0.5">
              <span id="err-message" class="hidden text-rose-500"></span>
              <span id="char-counter" class="ml-auto">0 / 5,000</span>
            </div>
          </div>

          <!-- Submission Controls -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pt-2">
            <button
              type="submit"
              id="submit-btn"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-900 text-sm font-mono font-semibold transition-colors cursor-pointer disabled:opacity-50 shadow-xs"
            >
              <span id="btn-text">Transmit Technical Brief</span>
              <span id="btn-icon">→</span>
            </button>

            <button
              type="button"
              id="copy-payload-btn"
              class="text-xs font-mono text-zinc-500 dark:text-zinc-400 hover:text-sky-600 dark:hover:text-sky-400 underline underline-offset-4 text-center sm:text-right"
            >
              Copy formatted brief to clipboard
            </button>
          </div>
        </form>

        <!-- Feedback & Status Notification Area -->
        <div id="status-box" class="hidden mt-4 p-4 rounded-lg text-xs sm:text-sm font-mono border transition-all"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Real-time Push Notification & Serverless Relay endpoints
  // Zero private tokens or secrets stored in client-side code
  const NTFY_TOPIC = "sirsahol-ops-briefs-9x7q2m";
  const SCRIPT_WEBAPP_URL = window.SCRIPT_WEBAPP_URL || "";
  const OWNER_EMAIL = "sirsahol@gmail.com";

  const form = document.getElementById("inlet-form");
  const submitBtn = document.getElementById("submit-btn");
  const btnText = document.getElementById("btn-text");
  const btnIcon = document.getElementById("btn-icon");
  const statusBox = document.getElementById("status-box");
  const copyBtn = document.getElementById("copy-payload-btn");
  const msgInput = document.getElementById("client-message");
  const charCounter = document.getElementById("char-counter");

  // Character counter
  msgInput?.addEventListener("input", () => {
    const len = msgInput.value.length;
    charCounter.textContent = `${len.toLocaleString()} / 5,000`;
  });

  // Client-side regex rules matching admin-scaffold-protocol
  const NAME_RE = /^[\p{L}\p{M}'-]+(?:\.|\s[\p{L}\p{M}'-]+|\.[\p{L}\p{M}'-]+)*$/u;
  const EMAIL_RE = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$/;

  function clearErrors() {
    ["firstName", "lastName", "email", "message"].forEach((f) => {
      const err = document.getElementById(`err-${f}`);
      if (err) {
        err.classList.add("hidden");
        err.textContent = "";
      }
    });
  }

  function showFieldError(field, msg) {
    const err = document.getElementById(`err-${field}`);
    if (err) {
      err.classList.remove("hidden");
      err.textContent = msg;
    }
  }

  function getNormalizedPayload() {
    const firstName = (document.getElementById("client-first-name").value || "").trim().replace(/\s+/g, " ");
    const lastName = (document.getElementById("client-last-name").value || "").trim().replace(/\s+/g, " ");
    const email = (document.getElementById("client-email").value || "").trim().toLowerCase();
    const organization = (document.getElementById("client-org").value || "").trim().replace(/\s+/g, " ");
    const track = document.getElementById("client-track").value;
    const message = (document.getElementById("client-message").value || "").trim();

    return { firstName, lastName, email, organization, track, message };
  }

  function formatBriefText(p) {
    return [
      "Systems Architecture Technical Brief",
      "------------------------------------",
      `Name: ${p.firstName} ${p.lastName}`,
      `Email: ${p.email}`,
      `Organization: ${p.organization || "Independent"}`,
      `Inquiry Track: ${p.track}`,
      "",
      "Scope & Objectives:",
      p.message
    ].join("\n");
  }

  function buildMailtoUrl(p) {
    const fullName = `${p.firstName} ${p.lastName}`;
    const subject = encodeURIComponent(`[Technical Brief] ${p.track} — ${fullName}`);
    const body = encodeURIComponent(formatBriefText(p));
    return `mailto:${OWNER_EMAIL}?subject=${subject}&body=${body}`;
  }

  function copyTextToClipboard(text, triggerEl, successLabel = "✓ Brief copied to clipboard") {
    const originalText = triggerEl.textContent;
    navigator.clipboard.writeText(text).then(() => {
      triggerEl.textContent = successLabel;
      setTimeout(() => {
        triggerEl.textContent = originalText;
      }, 2500);
    }).catch(() => {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
      triggerEl.textContent = successLabel;
      setTimeout(() => {
        triggerEl.textContent = originalText;
      }, 2500);
    });
  }

  copyBtn?.addEventListener("click", () => {
    const p = getNormalizedPayload();
    copyTextToClipboard(formatBriefText(p), copyBtn);
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearErrors();

    const p = getNormalizedPayload();
    let hasError = false;

    // Phase 3: Invariant validation
    if (!p.firstName || p.firstName.length < 2) {
      showFieldError("firstName", "First name must be at least 2 characters.");
      hasError = true;
    } else if (!NAME_RE.test(p.firstName)) {
      showFieldError("firstName", "First name contains invalid characters.");
      hasError = true;
    }

    if (!p.lastName || p.lastName.length < 2) {
      showFieldError("lastName", "Last name must be at least 2 characters.");
      hasError = true;
    } else if (!NAME_RE.test(p.lastName)) {
      showFieldError("lastName", "Last name contains invalid characters.");
      hasError = true;
    }

    if (!p.email || !EMAIL_RE.test(p.email)) {
      showFieldError("email", "Please provide a valid work or professional email address.");
      hasError = true;
    }

    if (!p.message || p.message.length < 20) {
      showFieldError("message", "Technical brief must be at least 20 characters to provide context.");
      hasError = true;
    }

    if (hasError) return;

    submitBtn.disabled = true;
    btnText.textContent = "Transmitting brief...";
    btnIcon.textContent = "●";

    const fullName = `${p.firstName} ${p.lastName}`;
    const payload = {
      action: "inlet_brief",
      firstName: p.firstName,
      lastName: p.lastName,
      fullName: fullName,
      email: p.email,
      organization: p.organization || "Independent",
      track: p.track,
      message: p.message,
      source: "sirsahol.github.io/contact-inlet"
    };

    let delivered = false;

    // 1. Direct Instant Mobile Push Relay via ntfy.sh (Zero-credential, lock-screen alert on iPhone & Mac)
    if (NTFY_TOPIC) {
      try {
        const ntfyRes = await fetch("https://ntfy.sh", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            topic: NTFY_TOPIC,
            title: `⚡ Systems Inquiry: ${p.track} (${fullName})`,
            message: `From: ${fullName} (${p.email})\nOrg: ${p.organization || "Independent"}\nTrack: ${p.track}\n\nScope & Brief:\n${p.message}`,
            priority: 4,
            tags: ["briefcase", "zap"],
            actions: [
              {
                action: "view",
                label: `✉ Email ${p.firstName}`,
                url: `mailto:${p.email}?subject=Re:%20${encodeURIComponent(p.track)}`
              },
              {
                action: "view",
                label: "📅 Meet Calendar",
                url: "https://sirsahol.github.io/meet"
              }
            ]
          })
        });
        if (ntfyRes.ok) {
          delivered = true;
        }
      } catch (err) {
        console.warn("Direct push notification notice:", err);
      }
    }

    // 2. Optional Apps Script Web App Relay (Writes to Google Sheets ledger & sends backup email)
    if (SCRIPT_WEBAPP_URL) {
      try {
        const response = await fetch(SCRIPT_WEBAPP_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload)
        });

        if (response.ok) {
          const resData = await response.json().catch(() => ({ success: true }));
          if (resData.success !== false) {
            delivered = true;
          }
        }
      } catch (err) {
        console.warn("Apps Script relay notice:", err);
      }
    }

    if (delivered) {
      statusBox.className = "mt-4 p-4 rounded-lg text-xs sm:text-sm font-mono border bg-emerald-50/60 dark:bg-emerald-950/20 border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 block";
      statusBox.innerHTML = `
        <div class="font-bold mb-1">✓ Transmitted Successfully</div>
        <p class="leading-relaxed">Your briefing has been delivered directly. I will review your requirements and respond to <strong>${p.email}</strong> within 24–48 business hours.</p>
      `;
      form.reset();
      charCounter.textContent = "0 / 5,000";
      btnText.textContent = "Brief Delivered";
      btnIcon.textContent = "✓";
      submitBtn.disabled = false;
    } else {
      // Clean fallback: Formatted brief clipboard copy + direct mailto link to owner
      const mailtoUrl = buildMailtoUrl(p);
      statusBox.className = "mt-4 p-4 rounded-lg text-xs sm:text-sm font-mono border bg-amber-50/60 dark:bg-amber-950/20 border-amber-300 dark:border-amber-800 text-amber-900 dark:text-amber-200 block";
      statusBox.innerHTML = `
        <div class="font-bold mb-1">Direct Delivery Relay Standby</div>
        <p class="mb-3 leading-relaxed">
          Your brief has been validated and formatted. Choose your preferred delivery method below to transmit directly:
        </p>
        <div class="flex flex-wrap items-center gap-2.5">
          <a
            href="${mailtoUrl}"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md bg-zinc-900 dark:bg-zinc-100 hover:bg-zinc-800 dark:hover:bg-white text-white dark:text-zinc-900 font-semibold text-xs transition-colors"
          >
            <span>✉ Dispatch via Email Client</span>
          </a>
          <button
            type="button"
            id="retry-copy-btn"
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 hover:bg-zinc-50 dark:hover:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold text-xs transition-colors cursor-pointer"
          >
            <span>📋 Copy Formatted Brief</span>
          </button>
        </div>
      `;

      document.getElementById("retry-copy-btn")?.addEventListener("click", () => {
        copyBtn.click();
      });

      btnText.textContent = "Transmit Technical Brief";
      btnIcon.textContent = "→";
      submitBtn.disabled = false;
    }
  });
</script>
